<%- include('partials/page-start', {
  pageTitle: 'Daily Report - Smart Work Time Tracker',
  bodyClass: 'report-page'
}) %>
    <div class="container py-4">
      <div class="card hero-card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex flex-column flex-xl-row justify-content-between gap-3 align-items-start align-items-xl-center">
            <div class="hero-copy">
              <p class="eyebrow mb-2">A2Z TIME TRACKING SYSTEM</p>
              <h1 class="mb-2 hero-title">Daily Report</h1>
              <p class="text-muted mb-0 hero-subtitle">
                <% if (selectedDate) { %>
                Showing data for <strong><%= formatDayWithDate(selectedDate) %></strong>
                <% } else { %>
                Select a date to see the weekday and download a report
                <% } %>
              </p>
            </div>

            <div class="header-actions d-flex flex-column flex-sm-row gap-2 w-100 w-xl-auto align-items-stretch align-items-sm-center">
              <span class="user-chip text-truncate text-success">User: <strong><%= currentUser.full_name %></strong></span>
            </div>
          </div>

          <div class="hero-metrics mt-3">
            <div class="hero-metric-item">
              <span class="hero-metric-label">Records</span>
              <strong class="hero-metric-value"><%= logs.length %></strong>
            </div>
            <div class="hero-metric-item">
              <span class="hero-metric-label">Selected Day</span>
              <strong class="hero-metric-value"><%= selectedDate ? selectedDate.split('-').reverse().join('-') : 'Select a date' %></strong>
            </div>
            <div class="hero-metric-item">
              <span class="hero-metric-label">Total Duration</span>
              <strong class="hero-metric-value"><%= formatSeconds(totalDuration || 0) %></strong>
            </div>
          </div>
        </div>
      </div>

      <div class="card shadow-sm mb-4 task-card">
        <div class="card-body">
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-2 mb-2">
            <h5 class="card-title mb-0">Report Filters</h5>
            <p class="text-muted mb-0 small">Choose a date and export polished reports in Excel or PDF.</p>
          </div>
          <form action="/report" method="GET" class="row g-3 align-items-end task-form report-toolbar">
            <div class="col-12 col-md-4 col-lg-3">
              <label for="date" class="form-label">Select Date</label>
              <input
                type="date"
                id="date"
                name="date"
                class="form-control"
                value="<%= selectedDate || '' %>"
              />
            </div>
            <div class="col-12 col-md-8 col-lg-9 report-actions d-flex flex-wrap gap-2">
              <button type="submit" class="btn btn-primary">View Report</button>
              <a href="/report" class="btn btn-outline-secondary">Clear Filter</a>
              <% if (selectedDate) { %>
              <a
                href="/report/export/excel?date=<%= encodeURIComponent(selectedDate) %>"
                class="btn btn-success"
              >
                Download Excel
              </a>
              <a
                href="/report/export/pdf?date=<%= encodeURIComponent(selectedDate) %>"
                class="btn btn-danger"
              >
                Download PDF
              </a>
              <a
                href="/report/export/image?date=<%= encodeURIComponent(selectedDate) %>"
                class="btn btn-warning text-dark"
              >
                Download Image
              </a>
              <% } else { %>
              <span class="btn btn-success disabled" aria-disabled="true" tabindex="-1">Download Excel</span>
              <span class="btn btn-danger disabled" aria-disabled="true" tabindex="-1">Download PDF</span>
              <span class="btn btn-warning text-dark disabled" aria-disabled="true" tabindex="-1">Download Image</span>
              <% } %>
            </div>
          </form>
          <% if (!selectedDate) { %>
          <div class="mt-3 text-muted small">Select a date first. Then PDF and Excel will show only that day’s report.</div>
          <% } %>
        </div>
      </div>

      <div class="card shadow-sm">
        <div class="card-body">
          <div class="report-summary mb-3 d-flex flex-wrap gap-2">
            <span class="badge text-bg-light">Records: <%= logs.length %></span>
            <span class="badge text-bg-light">Report Day: <%= selectedDate ? formatDayWithDate(selectedDate) : 'Select a date' %></span>
            <span class="badge  bg-dark text-white">Total: <%= formatSeconds(totalDuration || 0) %></span>
          </div>
          <div class="table-responsive report-table-wrap">
            <table class="table table-striped align-middle mb-0 report-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Task Name</th>
                  <th>Task Date</th>
                  <th>Start Time</th>
                  <th>End Time</th>
                  <th>Sessions</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <% if (logs.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center text-muted py-4">No tasks logged yet.</td>
                </tr>
                <% } %>

                <% logs.forEach((log, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= log.task_name %></td>
                  <td class="text-nowrap"><%= formatReportDate(log.task_date) %></td>
                  <td class="text-nowrap"><%= formatTimeOnly(log.start_time) %></td>
                  <td class="text-nowrap"><%= log.end_time ? formatTimeOnly(log.end_time) : 'Running' %></td>
                  <td><%= log.session_count || 0 %></td>
                  <td><%= formatSeconds(log.duration || 0) %></td>
                </tr>
                <% }) %>
              </tbody>
              <tfoot>
                <tr class="report-total-row">
                  <th colspan="6" class="text-end">Total Daily Work Duration</th>
                  <th><%= formatSeconds(totalDuration || 0) %></th>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>
<%- include('partials/page-end') %>
