<%- include('partials/page-start', {
  pageTitle: 'My Profile - Smart Work Time Tracker',
  bodyClass: 'profile-page'
}) %>
    <div class="container py-4">
      <div class="card hero-card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">
            <div class="hero-copy">
              <p class="eyebrow mb-2">Account</p>
              <h1 class="hero-title mb-1">My Profile</h1>
              <p class="hero-subtitle mb-0">Update your profile image and open it in full size.</p>
            </div>
            <div class="header-actions d-flex flex-column flex-sm-row gap-2 w-100 w-lg-auto">
              <a href="/tasks" class="btn btn-outline-secondary">Back to Tasks</a>
            </div>
          </div>
        </div>
      </div>

      <%- include('partials/flash-messages', { error: error, success: success }) %>

      <div class="card shadow-sm profile-card">
        <div class="card-body p-4">
          <div class="row g-4 align-items-start">
            <div class="col-12 col-md-4 text-center">
              <% if (user.profile_image) { %>
              <a href="<%= user.profile_image %>" target="_blank" rel="noopener noreferrer" class="profile-image-link" title="Open full image">
                <img src="<%= user.profile_image %>" alt="Profile image" class="profile-page-image" />
              </a>
              <% } else { %>
              <div class="profile-page-image profile-page-fallback" aria-label="Profile image fallback">
                <%= String(user.full_name || 'U').trim().charAt(0).toUpperCase() %>
              </div>
              <% } %>
              <p class="small text-muted mt-2 mb-0">Click image to open full size.</p>
            </div>

            <div class="col-12 col-md-8">
              <h5 class="mb-3">Profile Details</h5>
              <div class="mb-3">
                <label class="form-label mb-1">Full Name</label>
                <div class="form-control bg-light"><%= user.full_name %></div>
              </div>
              <div class="mb-3">
                <label class="form-label mb-1">Email</label>
                <div class="form-control bg-light"><%= user.email %></div>
              </div>
              <div class="mb-3">
                <label class="form-label mb-1">Member Since</label>
                <div class="form-control bg-light"><%= new Date(user.created_at).toLocaleDateString('en-GB') %></div>
              </div>

              <form action="/profile/image" method="POST" enctype="multipart/form-data" class="row g-3 auth-form">
                <div class="col-12">
                  <label class="form-label">Edit Profile Image</label>
                  <input
                    type="file"
                    name="profile_image"
                    class="form-control"
                    accept="image/png,image/jpeg,image/webp"
                    required
                  />
                  <div class="form-text">Allowed: JPG, PNG, WEBP.</div>
                </div>
                <div class="col-12 d-grid d-sm-flex gap-2">
                  <button type="submit" class="btn btn-primary">Update Image</button>
                  <a href="/profile" class="btn btn-outline-secondary">Refresh</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
<%- include('partials/page-end') %>
