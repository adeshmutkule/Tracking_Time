<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Task - Smart Work Time Tracker</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Edit Task</h1>
        <div class="d-flex gap-2 align-items-center">
          <span class="small text-muted">User: <strong><%= currentUser.full_name %></strong></span>
          <a href="/" class="btn btn-outline-secondary">Back</a>
          <a href="/logout" class="btn btn-outline-danger">Logout</a>
        </div>
      </div>

      <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <div class="card shadow-sm">
        <div class="card-body">
          <form action="/task/<%= task.id %>/edit" method="POST" class="row g-3">
            <div class="col-12">
              <label class="form-label">Task Name</label>
              <input
                type="text"
                name="task_name"
                class="form-control"
                value="<%= task.task_name %>"
                required
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">Task Date</label>
              <input
                type="date"
                name="task_date"
                class="form-control"
                value="<%= taskDateValue %>"
                required
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">Start Time</label>
              <input
                type="time"
                name="start_time"
                class="form-control"
                value="<%= startTimeValue %>"
                required
              />
            </div>
            <div class="col-md-6">
              <label class="form-label">End Time (Optional)</label>
              <input
                type="time"
                name="end_time"
                class="form-control"
                value="<%= endTimeValue %>"
              />
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary">Save Changes</button>
              <a href="/" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </form>
        </div>
      </div>

      <% if (latestLog) { %>
      <p class="text-muted small mt-3 mb-0">
        Latest session: <%= latestLog.end_time ? 'Completed session time will be recalculated based on updated start/end time.' : 'Task is currently running. You can set end time to close this session.' %>
      </p>
      <% } %>
    </div>
  </body>
</html>
