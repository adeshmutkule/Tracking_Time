<%- include('partials/page-start', {
  pageTitle: 'Tasks - Smart Work Time Tracker',
  bodyClass: 'tasks-page'
}) %>
    <div class="container py-4">
      <div class="card hero-card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-start align-items-lg-center">
            <div>
              <p class="eyebrow mb-2">A2Z TIME TRACKING SYSTEM</p>
              <h1 class="mb-1">Task Center</h1>
              <p class="text-muted mb-0">View and manage your tasks by date.</p>
            </div>
            <div class="header-actions d-flex flex-column flex-sm-row gap-2 w-100 w-lg-auto align-items-stretch align-items-sm-center">
              <span class="user-chip text-truncate">User: <strong><%= currentUser.full_name %></strong></span>
            </div>
          </div>
        </div>
      </div>

      <%- include('partials/flash-messages', { error: error, success: success }) %>

      <div class="card mb-4 shadow-sm task-card">
        <div class="card-body">
          <h5 class="card-title">Filter Tasks</h5>
          <form action="/tasks" method="GET" class="row g-3 align-items-end task-form">
            <div class="col-12 col-md-4 col-lg-3">
              <label for="filterDate" class="form-label">Select Date</label>
              <input
                type="date"
                id="filterDate"
                name="date"
                class="form-control"
                value="<%= selectedDate || '' %>"
                required
              />
            </div>
            <div class="col-12 col-md-4 col-lg-3">
              <label for="statusFilter" class="form-label">Status</label>
              <select id="statusFilter" name="status" class="form-select">
                <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All</option>
                <option value="running" <%= selectedStatus === 'running' ? 'selected' : '' %>>Running</option>
                <option value="paused" <%= selectedStatus === 'paused' ? 'selected' : '' %>>Paused</option>
                <option value="completed" <%= selectedStatus === 'completed' ? 'selected' : '' %>>Completed</option>
                <option value="idle" <%= selectedStatus === 'idle' ? 'selected' : '' %>>Idle</option>
              </select>
            </div>
            <div class="col-12 col-md-4 col-lg-3">
              <label for="taskSearch" class="form-label">Task Search</label>
              <input
                id="taskSearch"
                type="text"
                name="search"
                class="form-control"
                placeholder="Search task name"
                value="<%= searchTerm || '' %>"
              />
            </div>
            <div class="col-12 col-lg-3 d-flex gap-2 flex-wrap">
              <button type="submit" class="btn btn-primary">Show Tasks</button>
              <a href="/tasks" class="btn btn-outline-secondary">Today</a>
            </div>
          </form>
        </div>
      </div>

      <div class="card shadow-sm task-card">
        <div class="card-body">
          <h5 class="card-title">Tasks</h5>
          <div class="task-mobile-list d-md-none">
            <% if (tasks.length === 0) { %>
            <div class="task-mobile-empty text-center text-muted py-4">No tasks available.</div>
            <% } %>

            <% tasks.forEach((task) => { %>
            <div class="task-mobile-item">
              <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                <div>
                  <div class="task-mobile-label">Task Name</div>
                  <div class="task-mobile-title"><%= task.task_name %></div>
                </div>
                <span class="badge status-badge status-<%= task.status %>"><%= task.status %></span>
              </div>

              <div class="task-mobile-meta">
                <div>
                  <span class="task-mobile-label">ID</span>
                  <span><%= task.id %></span>
                </div>
                <div>
                  <span class="task-mobile-label">Task Date</span>
                  <span><%= formatReportDate(task.task_date) %></span>
                </div>
                <div>
                  <span class="task-mobile-label">Total Time</span>
                  <span>
                    <strong
                      class="js-live-timer"
                      data-base-seconds="<%= (task.display_total_time ?? task.total_time) || 0 %>"
                      data-running="<%= task.status === 'running' ? '1' : '0' %>"
                    ><%= formatSeconds((task.display_total_time ?? task.total_time) || 0) %></strong>
                  </span>
                </div>
              </div>

              <div class="task-mobile-actions">
                <%- include('partials/task-actions', { task: task }) %>
              </div>

            </div>
            <% }) %>
          </div>

          <div class="table-responsive d-none d-md-block">
            <table class="table table-striped align-middle mb-0 task-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Task Name</th>
                  <th>Task Date</th>
                  <th>Status</th>
                  <th>Total Time</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (tasks.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center text-muted py-4">No tasks available.</td>
                </tr>
                <% } %>

                <% tasks.forEach((task) => { %>
                <tr>
                  <td><%= task.id %></td>
                  <td><%= task.task_name %></td>
                  <td><%= formatReportDate(task.task_date) %></td>
                  <td>
                    <span class="badge status-badge status-<%= task.status %>">
                      <%= task.status %>
                    </span>
                  </td>
                  <td>
                    <strong
                      class="js-live-timer"
                      data-base-seconds="<%= (task.display_total_time ?? task.total_time) || 0 %>"
                      data-running="<%= task.status === 'running' ? '1' : '0' %>"
                    ><%= formatSeconds((task.display_total_time ?? task.total_time) || 0) %></strong>
                  </td>
                  <td class="text-end action-buttons">
                    <div class="task-action-grid">
                      <%- include('partials/task-actions', { task: task }) %>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <script src="/time-utils.js"></script>
    <script>
      (function initializeLiveTimers() {
        const timerNodes = document.querySelectorAll('.js-live-timer');

        if (!timerNodes.length) {
          return;
        }

        const timers = Array.from(timerNodes).map((node) => ({
          node,
          baseSeconds: Math.max(Number(node.dataset.baseSeconds || 0), 0),
          isRunning: node.dataset.running === '1'
        }));

        const startTick = Date.now();

        function render() {
          const elapsed = Math.floor((Date.now() - startTick) / 1000);

          timers.forEach((timer) => {
            const value = timer.isRunning ? timer.baseSeconds + elapsed : timer.baseSeconds;
            timer.node.textContent = window.formatSecondsHms(value);
          });
        }

        render();
        window.setInterval(render, 1000);
      })();

      (function setupAutoSync() {
        const REFRESH_MS = 30000;

        window.setInterval(() => {
          const activeEl = document.activeElement;
          const tagName = activeEl ? activeEl.tagName : '';
          const editing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(tagName);

          if (!editing) {
            window.location.reload();
          }
        }, REFRESH_MS);
      })();
    </script>
<%- include('partials/page-end') %>
