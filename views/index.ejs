<%- include('partials/page-start', {
  pageTitle: 'Dashboard - Smart Work Time Tracker',
  bodyClass: 'dashboard-page'
}) %>
    <div class="container py-4">
      <div class="card hero-card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex flex-column flex-xl-row justify-content-between gap-3 align-items-start align-items-xl-center">
            <div class="hero-copy">
              <!-- <p class="eyebrow mb-2"> Welcome</p> -->
              <h1 class="mb-2 hero-title">A2Z TIME TRACKING SYSTEM</h1>
              <p class="text-muted mb-0 hero-subtitle">Create tasks quickly, monitor live work, and close your day with accurate reports.</p>
            </div>

            <div class="header-actions d-flex flex-column flex-sm-row gap-2 w-100 w-xl-auto align-items-stretch align-items-sm-center">
              <span
                class="user-chip today-chip js-today-total-chip"
                data-base-seconds="<%= todayTotalSeconds || 0 %>"
                data-active-count="<%= activeSessionCount || 0 %>"
              >
                Today Total:
                <strong class="js-today-total-text"><%= formatSeconds(todayTotalSeconds || 0) %></strong>
              </span>
              <span class="user-chip text-truncate">User: <strong><%= currentUser.full_name %></strong></span>
            </div>
          </div>

          <div class="hero-metrics mt-3">
            <div class="hero-metric-item">
              <span class="hero-metric-label">Today Total</span>
              <strong class="hero-metric-value js-today-total-text"><%= formatSeconds(todayTotalSeconds || 0) %></strong>
            </div>
            <div class="hero-metric-item">
              <span class="hero-metric-label">Active Sessions</span>
              <strong class="hero-metric-value"><%= activeSessionCount || 0 %></strong>
            </div>
            <div class="hero-metric-item">
              <span class="hero-metric-label">Selected Date</span>
              <strong class="hero-metric-value"><%= selectedDate ? selectedDate.split('-').reverse().join('-') : '-' %></strong>
            </div>
          </div>
        </div>
      </div>

      <div class="dashboard-grid mb-4">
        <div class="dashboard-tile">
          <h6>Work Mode</h6>
          <p>Plan your day, create tasks quickly, and track sessions in real time.</p>
        </div>
        <div class="dashboard-tile">
          <h6>Task Timeline</h6>
          <p>Open Task Center to start, pause, resume, and complete each task flow.</p>
        </div>
        <div class="dashboard-tile">
          <h6>Accurate Reports</h6>
          <p>Get day-based exports in Excel and PDF for easy team updates.</p>
        </div>
      </div>

      <%- include('partials/flash-messages', { error: error, success: success }) %>

      <div class="card mb-4 shadow-sm task-card">
        <div class="card-body">
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-2 mb-2">
            <h5 class="card-title mb-0">Add New Task</h5>
            <p class="text-muted mb-0 small">Tip: Use previous task names from suggestions for faster entry.</p>
          </div>
          <form action="/add-task" method="POST" class="row g-3 align-items-end task-form">
            <div class="col-12 col-lg-5">
              <label class="form-label">Task Name</label>
              <input
                type="text"
                name="task_name"
                class="form-control"
                placeholder="Enter task name"
                list="task-name-suggestions"
                autocomplete="off"
                required
              />
              <datalist id="task-name-suggestions">
                <% (taskNameSuggestions || []).forEach((name) => { %>
                <option value="<%= name %>"></option>
                <% }) %>
              </datalist>
            </div>
            <div class="col-6 col-lg-3">
              <label class="form-label">Task Date</label>
              <input type="date" name="task_date" class="form-control" value="<%= selectedDate || '' %>" required />
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label">Start Time</label>
              <input type="time" name="start_time" class="form-control" required />
            </div>
            <div class="col-12 col-lg-2 d-grid">
              <button type="submit" class="btn btn-primary btn-add-task">Add Task</button>
            </div>
          </form>
        </div>
      </div>

    </div>

    <script src="/time-utils.js"></script>
    <script>
      (function renderTodayTotalLive() {
        const chip = document.querySelector('.js-today-total-chip');
        const textNodes = document.querySelectorAll('.js-today-total-text');

        if (!chip || !textNodes.length) {
          return;
        }

        const baseSeconds = Math.max(Number(chip.dataset.baseSeconds || 0), 0);
        const activeCount = Math.max(Number(chip.dataset.activeCount || 0), 0);
        const startAt = Date.now();

        function draw() {
          const elapsed = Math.floor((Date.now() - startAt) / 1000);
          const value = window.formatSecondsHms(baseSeconds + elapsed * activeCount);
          textNodes.forEach((node) => {
            node.textContent = value;
          });
        }

        draw();

        if (activeCount > 0) {
          window.setInterval(draw, 1000);
        }
      })();
    </script>
<%- include('partials/page-end') %>
