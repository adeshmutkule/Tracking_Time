<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smart Work Time Tracker</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container py-4">
      <div class="card hero-card shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-start align-items-lg-center">
            <div>
              <p class="eyebrow mb-2">Time Tracking Portal</p>
              <h1 class="mb-1">Smart Work Time Tracker</h1>
              <p class="text-muted mb-0">Track work time per user with a clean responsive dashboard.</p>
            </div>
            <div class="header-actions d-flex flex-column flex-sm-row gap-2 w-100 w-lg-auto align-items-stretch align-items-sm-center">
              <span class="user-chip text-truncate">User: <strong><%= currentUser.full_name %></strong></span>
              <a href="/report" class="btn btn-outline-primary">Daily Report</a>
              <a href="/logout" class="btn btn-outline-danger">Logout</a>
            </div>
          </div>
        </div>
      </div>

      <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
      <% } %>

      <div class="card mb-4 shadow-sm task-card">
        <div class="card-body">
          <h5 class="card-title">Add New Task</h5>
          <form action="/add-task" method="POST" class="row g-3 align-items-end task-form">
            <div class="col-12 col-lg-5">
              <label class="form-label">Task Name</label>
              <input
                type="text"
                name="task_name"
                class="form-control"
                placeholder="Enter task name"
                required
              />
            </div>
            <div class="col-6 col-lg-3">
              <label class="form-label">Task Date</label>
              <input type="date" name="task_date" class="form-control" required />
            </div>
            <div class="col-6 col-lg-2">
              <label class="form-label">Start Time</label>
              <input type="time" name="start_time" class="form-control" required />
            </div>
            <div class="col-12 col-lg-2 d-grid">
              <button type="submit" class="btn btn-primary btn-add-task">Add Task</button>
            </div>
          </form>
        </div>
      </div>

      <div class="card shadow-sm task-card">
        <div class="card-body">
          <h5 class="card-title">Tasks</h5>
          <div class="table-responsive">
            <table class="table table-striped align-middle mb-0 task-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Task Name</th>
                  <th>Task Date</th>
                  <th>Status</th>
                  <th>Total Time</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (tasks.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center text-muted py-4">No tasks available.</td>
                </tr>
                <% } %>

                <% tasks.forEach((task) => { %>
                <tr>
                  <td><%= task.id %></td>
                  <td><%= task.task_name %></td>
                  <td><%= task.task_date ? new Date(task.task_date).toLocaleDateString() : '-' %></td>
                  <td>
                    <span class="badge status-badge status-<%= task.status %>">
                      <%= task.status %>
                    </span>
                  </td>
                  <td><strong><%= formatSeconds(task.total_time || 0) %></strong></td>
                  <td class="text-end action-buttons">
                    <div class="task-action-grid">
                      <a href="/task/<%= task.id %>/edit" class="btn btn-sm btn-primary">Edit</a>
                      <a href="/start/<%= task.id %>" class="btn btn-sm btn-success">Start</a>
                      <a href="/pause/<%= task.id %>" class="btn btn-sm btn-warning">Pause</a>
                      <a href="/resume/<%= task.id %>" class="btn btn-sm btn-info text-white">Resume</a>
                      <a href="/end/<%= task.id %>" class="btn btn-sm btn-dark">End</a>
                      <a
                        href="/delete/<%= task.id %>"
                        class="btn btn-sm btn-danger"
                        onclick="return confirm('Delete this task and all logs?')"
                      >
                        Delete
                      </a>
                    </div>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
